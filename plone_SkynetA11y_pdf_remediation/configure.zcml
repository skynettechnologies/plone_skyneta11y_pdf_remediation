<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    xmlns:i18n="http://namespaces.zope.org/i18n"
    i18n_domain="plone_SkynetA11y_pdf_remediation">

  <include package="plone.app.registry" />
  <include package=".browser" />

  <!-- Install / uninstall profiles -->
  <genericsetup:registerProfile
      name="default"
      title="SkynetA11y PDF Remediation"
      description="PDF accessibility (WCAG / PDF-UA) remediation dashboard: upload PDFs, scan a website for PDFs, download AI-remediated copies."
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/default"
      />

  <genericsetup:registerProfile
      name="uninstall"
      title="SkynetA11y PDF Remediation: uninstall"
      description="Removes SkynetA11y PDF Remediation."
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/uninstall"
      />

  <utility
      factory=".setuphandlers.HiddenProfiles"
      name="plone_SkynetA11y_pdf_remediation-hiddenprofiles"
      />

  <!-- Vocabulary for the "Initial tab" setting -->
  <utility
      component=".vocabularies.tabs_vocabulary"
      name="plone_SkynetA11y_pdf_remediation.tabs"
      />

  <include file="upgrades.zcml" />

</configure>
